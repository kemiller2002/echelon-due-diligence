{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Recommendation for another repository or the organization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "target",
    "title",
    "recommendation",
    "rationale",
    "traces_to",
    "priority",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^REC-[A-Z0-9]+-[0-9]{3}$"
    },
    "target": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "recommendation": {
      "type": "string"
    },
    "rationale": {
      "type": "string"
    },
    "traces_to": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "effort": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "very-high",
        "unknown"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "done"
      ]
    }
  }
}