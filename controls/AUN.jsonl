{"id": "ECTL-AUN-005", "title": "NIST SP 800-63B-4 password handling and throttling", "objective": "Enforce length-based password rules with breached-password screening, no composition or periodic rotation rules, approved salted password hashing, and per-account and per-source throttling that resists lockout abuse.", "control_type": "preventive-structural", "assurance_level": "L3-restricted-interface", "implementing_systems": ["not yet assigned"], "status": "proposed-target-state", "evidence_requirements": ["EVR-AUN-005"], "owner": "Unassigned; proposed Security Lead", "policies": ["SEC-CRYPTO-001"], "cwe": ["CWE-521", "CWE-307", "CWE-916"], "framework_refs": [{"source_id": "SRC-NIST-SP800-63-4", "relation": "maps-to", "basis": "directly-documented", "locator": "SP 800-63B"}, {"source_id": "SRC-NIST-SP800-53-R5", "relation": "maps-to", "basis": "directly-documented", "locator": "IA-5(1)"}, {"source_id": "SRC-NIST-SP800-53-R5", "relation": "maps-to", "basis": "directly-documented", "locator": "AC-7"}, {"source_id": "SRC-OWASP-CHEATSHEETS", "relation": "informed-by", "basis": "reasonably-inferred"}]}
{"id": "ECTL-AUN-006", "title": "Server-side session management with revocation on credential and authority change", "objective": "Use opaque server-side sessions in Secure, HttpOnly, SameSite cookies, regenerate on login and privilege change, enforce risk-tiered timeouts, and revoke or recheck sessions and tokens on credential, contact, deactivation or authority change within a stated staleness bound.", "control_type": "preventive-structural", "assurance_level": "L3-restricted-interface", "implementing_systems": ["not yet assigned", "Limen (browser boundary; token storage rule to be defined)"], "status": "proposed-target-state", "evidence_requirements": ["EVR-AUN-006"], "owner": "Unassigned; proposed Security Lead", "policies": ["SEC-UI-002"], "related_external_controls": ["AUTH-I1"], "cwe": ["CWE-384", "CWE-613", "CWE-614", "CWE-1004"], "framework_refs": [{"source_id": "SRC-NIST-SP800-53-R5", "relation": "maps-to", "basis": "directly-documented", "locator": "AC-12"}, {"source_id": "SRC-NIST-SP800-53-R5", "relation": "maps-to", "basis": "directly-documented", "locator": "SC-23"}, {"source_id": "SRC-NIST-SP800-53-R5", "relation": "maps-to", "basis": "reasonably-inferred", "locator": "AC-11"}, {"source_id": "SRC-OWASP-CHEATSHEETS", "relation": "informed-by", "basis": "reasonably-inferred"}, {"source_id": "SRC-PCI-DSS-4.0.1", "relation": "informed-by", "basis": "reasonably-inferred", "locator": "Req 8.2.8"}]}
{"id": "ECTL-AUN-007", "title": "Recovery and contact-change controls with cooling-off holds", "objective": "Prohibit knowledge-based recovery; notify the prior channel with revert link on any credential or contact change; hold high-risk actions during a cooling-off period; enforce the contact assurance matrix in support tools without override.", "control_type": "preventive-structural", "assurance_level": "L3-restricted-interface", "implementing_systems": ["not yet assigned"], "status": "proposed-target-state", "evidence_requirements": ["EVR-AUN-007"], "owner": "Unassigned; proposed Security Lead", "related_external_controls": ["AUTH-I7", "CNV-PLT-011", "UNB-XIN-SVC-004"], "cwe": ["CWE-640"], "framework_refs": [{"source_id": "SRC-NIST-SP800-63-4", "relation": "maps-to", "basis": "directly-documented", "locator": "SP 800-63B"}, {"source_id": "SRC-SEC-REG-S-ID", "relation": "informed-by", "basis": "reasonably-inferred"}, {"source_id": "SRC-MITRE-ATTACK", "relation": "maps-to", "basis": "reasonably-inferred", "locator": "T1098"}]}
{"id": "ECTL-AUN-008", "title": "Command-bound step-up policy matrix", "objective": "Require a fresh step-up of the specified assurance, bound to the exact command and parameters and performed by a sponsor-controlled verifier, for each high-risk action class; reject commands without it.", "control_type": "preventive-structural", "assurance_level": "L3-restricted-interface", "implementing_systems": ["not yet assigned (Unbound authorization core)"], "status": "proposed-target-state", "evidence_requirements": ["EVR-AUN-008"], "owner": "Unassigned; proposed Security Lead", "policies": ["SEC-AUTH-001"], "related_external_controls": ["UNB-XIN-IAM-003", "TVR-SEC-004"], "cwe": ["CWE-306", "CWE-294"], "framework_refs": [{"source_id": "SRC-FFIEC-AUTH-GUIDANCE-2021", "relation": "informed-by", "basis": "reasonably-inferred"}, {"source_id": "SRC-NIST-SP800-53-R5", "relation": "maps-to", "basis": "directly-documented", "locator": "IA-11"}, {"source_id": "SRC-NIST-SP800-63-4", "relation": "maps-to", "basis": "reasonably-inferred", "locator": "SP 800-63B"}]}
{"id": "ECTL-AUN-009", "title": "Scoped, expiring credentials for APIs, widgets, webhooks and agents", "objective": "Authenticate integrations with OAuth client credentials or mutual TLS, users with authorization code plus PKCE, widgets with isolated short-lived tokens, webhooks with signatures and replay protection, and agents as their own lower-assurance principals.", "control_type": "preventive-structural", "assurance_level": "L3-restricted-interface", "implementing_systems": ["not yet assigned"], "status": "proposed-target-state", "evidence_requirements": ["EVR-AUN-009"], "owner": "Unassigned; proposed Security Lead", "policies": ["SEC-AUTH-001", "SEC-DATA-001"], "related_external_controls": ["UNB-API-STD-005", "AIN-029", "UNB-CTRL-067"], "cwe": ["CWE-287", "CWE-294", "CWE-345"], "framework_refs": [{"source_id": "SRC-OWASP-API-TOP10-2023", "relation": "maps-to", "basis": "directly-documented", "locator": "API2:2023"}, {"source_id": "SRC-NIST-SP800-53-R5", "relation": "maps-to", "basis": "reasonably-inferred", "locator": "IA-9"}, {"source_id": "SRC-NIST-SP800-53-R5", "relation": "maps-to", "basis": "reasonably-inferred", "locator": "IA-2(8)"}]}
