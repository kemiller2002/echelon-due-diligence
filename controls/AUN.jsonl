{"id": "ECTL-AUN-001", "title": "Workforce MFA enforced at the identity provider with phishing-resistant factors", "objective": "Require phishing-resistant MFA for all workforce sign-ins through IdP policy and AAL3-grade keys with two registrations for privileged roles; record and expire any exception.", "control_type": "preventive-gate", "assurance_level": "L3-restricted-interface", "implementing_systems": ["not yet assigned (workforce IdP)"], "status": "proposed-target-state", "evidence_requirements": ["EVR-AUN-001"], "owner": "Unassigned; proposed Security Lead", "related_external_controls": ["CNV-PLT-003", "SOC2-010", "UNB-CTRL-004"], "cwe": ["CWE-308"], "framework_refs": [{"source_id": "SRC-FTC-SAFEGUARDS-RULE", "relation": "informed-by", "basis": "directly-documented", "locator": "314.4(c)(5)"}, {"source_id": "SRC-NYDFS-PART-500", "relation": "informed-by", "basis": "directly-documented", "locator": "500.12"}, {"source_id": "SRC-NIST-SP800-53-R5", "relation": "maps-to", "basis": "directly-documented", "locator": "IA-2(1)"}, {"source_id": "SRC-NIST-SP800-53-R5", "relation": "maps-to", "basis": "directly-documented", "locator": "IA-2(2)"}, {"source_id": "SRC-CIS-CONTROLS-V8.1", "relation": "maps-to", "basis": "directly-documented", "locator": "6.5"}, {"source_id": "SRC-PCI-DSS-4.0.1", "relation": "informed-by", "basis": "reasonably-inferred", "locator": "Req 8.4.2"}]}
{"id": "ECTL-AUN-002", "title": "WebAuthn-first authentication with restricted fallbacks", "objective": "Offer and default to origin-bound WebAuthn authenticators; restrict SMS and voice; require number matching for any push; treat synced passkeys as insufficient alone for high-risk actions.", "control_type": "preventive-structural", "assurance_level": "L3-restricted-interface", "implementing_systems": ["not yet assigned (Unbound identity core)"], "status": "proposed-target-state", "evidence_requirements": ["EVR-AUN-002"], "owner": "Unassigned; proposed Security Lead", "related_external_controls": ["CNV-PLT-003", "TVR-SEC-010"], "cwe": ["CWE-308", "CWE-287"], "framework_refs": [{"source_id": "SRC-NIST-SP800-63-4", "relation": "maps-to", "basis": "directly-documented", "locator": "SP 800-63B"}, {"source_id": "SRC-CISA-SECURE-BY-DESIGN", "relation": "informed-by", "basis": "reasonably-inferred"}, {"source_id": "SRC-MITRE-ATTACK", "relation": "maps-to", "basis": "reasonably-inferred", "locator": "T1621"}, {"source_id": "SRC-MITRE-ATTACK", "relation": "maps-to", "basis": "reasonably-inferred", "locator": "T1539"}]}
