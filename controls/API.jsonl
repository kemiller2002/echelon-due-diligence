{"id": "ECTL-API-001", "title": "Central deny-by-default authorization for every API operation", "objective": "Evaluate object, property and function authorization on the server for every request through one policy point covering humans, institutions and agent principals; deny when no rule grants access.", "control_type": "preventive-structural", "assurance_level": "L3-restricted-interface", "implementing_systems": ["Unbound authorization model (not built)"], "policies": ["SEC-AUTH-001"], "related_external_controls": ["UNB-CTRL-067", "UNB-API-003", "UNB-API-005"], "cwe": ["CWE-639", "CWE-285", "CWE-863", "CWE-213"], "framework_refs": [{"source_id": "SRC-OWASP-API-TOP10-2023", "relation": "maps-to", "basis": "directly-documented", "locator": "API1:2023"}, {"source_id": "SRC-OWASP-API-TOP10-2023", "relation": "maps-to", "basis": "directly-documented", "locator": "API3:2023"}, {"source_id": "SRC-OWASP-API-TOP10-2023", "relation": "maps-to", "basis": "directly-documented", "locator": "API5:2023"}, {"source_id": "SRC-OWASP-ASVS", "relation": "maps-to", "basis": "reasonably-inferred", "locator": "5.0 V8 Authorization"}, {"source_id": "SRC-ECH-SCS-0.1", "relation": "derived-from", "basis": "directly-documented", "locator": "SEC-AUTH-001"}], "status": "proposed-target-state", "evidence_requirements": ["EVR-API-001"], "owner": "Engineering Lead (proposed role, unassigned)"}
