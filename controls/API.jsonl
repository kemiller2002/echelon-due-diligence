{"id": "ECTL-API-007", "title": "Idempotency keys on every mutating command", "objective": "Require a client-supplied idempotency key on every mutating operation, persist it with a payload hash and result in the same transaction as the effect, return the stored result on retry, reject key reuse with a different payload, and carry external idempotency keys to payment rails.", "control_type": "preventive-structural", "assurance_level": "L2-type-system", "implementing_systems": ["Unbound command layer (not built)"], "related_external_controls": ["UNB-API-004", "UNB-IMM-006", "UNB-EVT-002"], "cwe": ["CWE-837", "CWE-362"], "framework_refs": [{"source_id": "SRC-ECH-UNB-BASELINE", "relation": "derived-from", "basis": "directly-documented", "locator": "UNB-API-004"}, {"source_id": "SRC-ECH-UNB-BASELINE", "relation": "derived-from", "basis": "directly-documented", "locator": "UNB-IMM-006"}], "status": "proposed-target-state", "evidence_requirements": ["EVR-API-006"], "owner": "Engineering Lead (proposed role, unassigned)"}
{"id": "ECTL-API-008", "title": "Hardened API configuration baseline", "objective": "Enforce TLS-only, a restrictive CORS policy, no debug or introspection endpoints in production, uniform error format and security headers, checked continuously against a baseline.", "control_type": "detective-automated", "assurance_level": "L9-runtime-monitored", "implementing_systems": ["Hosting edge (not chosen)"], "cwe": ["CWE-16", "CWE-942", "CWE-215"], "framework_refs": [{"source_id": "SRC-OWASP-API-TOP10-2023", "relation": "maps-to", "basis": "directly-documented", "locator": "API8:2023"}, {"source_id": "SRC-OWASP-ASVS", "relation": "maps-to", "basis": "reasonably-inferred", "locator": "5.0 V4 API and Web Service"}], "status": "proposed-target-state", "evidence_requirements": ["EVR-API-007"], "owner": "Engineering Lead (proposed role, unassigned)"}
